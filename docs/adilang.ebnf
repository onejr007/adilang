# ============================================================================
# ADILang Formal Grammar — EBNF (W3C-style)
# Version: 1.14.0  |  Status: STABLE
# Author: ADI (Agent Distributed Intelligence) — designed by AI, for AI.
#
# This file is the normative, machine-parseable grammar of ADILang.
# It is the single source of truth for any parser/generator (human or AI).
# ADILang is a protocol / IR language with ONE top-level module per document:
#   world — 3D scene, implemented by the Rust/WASM world runtime
#   intent | reply | task | event | memory | plan | state — protocol modules,
#   implemented by the ADI backend (core/adilang_protocol.py) and consuming AIs.
# Notation follows W3C EBNF:
#   ::=     definition
#   "..."   literal terminal
#   '...'   literal terminal (alt quotes)
#   A?      zero or one
#   A*      zero or more
#   A+      one or more
#   (A B)   grouping / sequence
#   A | B   alternation
#   #xNN    unicode code point
#   -       exclusion
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Document (top level) — exactly one module per source document
# ---------------------------------------------------------------------------
document        ::= world | intent | reply | task | event | memory | plan | state
                  | ui_layout_block | web_block

# ─── v1.12.0: Web Platform blocks (optional; additive) ───────────────────────
ui_layout_block ::= "ui_layout" String "{" ui_component* "}"

ui_component    ::= "container" "{" ui_component* "}"
                  | "flex" ("row" | "column") ui_component*
                  | "text"    String
                  | "button"  String ("onClick" Ident)?
                  | "input"   String (Ident value)*
                  | "image"   (Ident value)*
                  | "card"    String? "{" ui_component* "}"
                  | "modal"   String? "{" ui_component* "}"
                  | "navbar"  String
                  | "footer"  String

web_block       ::= use_js_block | routes_block | i18n_block | component_block
use_js_block    ::= "@use_js" "{" "url" String (Ident value)* "}"
routes_block    ::= "routes" "{" ("route" (String Ident)*)+ "}"
i18n_block      ::= "@i18n" "{" ("locale" String "{" (Ident String)* "}")+ "}"

# ─── v1.13.0: Component lifecycle (optional; additive) ────────────────────────
component_block ::= "component" Ident "{" lifecycle_hook* "}"
lifecycle_hook  ::= ("on_mount" | "on_update" | "on_unmount") ":" directive
directive       ::= "@" Ident "(" expr_list ")"

# ─── Module: world (3D scene; Rust → WASM → WebGL2) ─────────────────────────
world           ::= "world" String "{" top_statement* "}"

top_statement   ::= camera_def
                  | light_def
                  | entity_def
                  | let_stmt
                  | func_def
                  | handler

camera_def      ::= "camera" String "{" prop* "}"
light_def       ::= "light"  String "{" prop* "}"
entity_def      ::= "entity" String "{" entity_member* "}"
entity_member   ::= prop | handler

# ---------------------------------------------------------------------------
# 2. Properties
# ---------------------------------------------------------------------------
# prop = a named value:  name expr
# A builder call (mesh/material) is a call whose name is a builder keyword and
# which may carry a trailing property block, e.g.  sphere { radius 1 segments 3 }
prop            ::= Ident prop_value
prop_value      ::= builder_call | Ident | expr

builder_call    ::= builder_name positional_args* ("{" prop* "}")?
builder_name    ::= "sphere" | "box" | "torus" | "icosa" | "ring"
                  | "plane" | "grid" | "solid" | "wire" | "glow" | "points"
positional_args ::= Number | tuple | String

# ---------------------------------------------------------------------------
# 3. Handlers (events)
# ---------------------------------------------------------------------------
handler         ::= "on" event_name "{" statement* "}"
event_name      ::= "frame" | "speak" | "silent" | "click"

# ---------------------------------------------------------------------------
# 4. Declarations
# ---------------------------------------------------------------------------
let_stmt        ::= "let" Ident "=" expr
func_def        ::= "func" Ident "(" param_list ")" "{" statement* "}"
param_list      ::= Ident*

# ---------------------------------------------------------------------------
# 5. Statements
# ---------------------------------------------------------------------------
statement       ::= let_stmt | if_stmt | return_stmt | while_stmt
                  | for_stmt | match_stmt | assign_stmt | expr_stmt | block
if_stmt         ::= "if" expr "{" statement* "}" ("else" "{" statement* "}")?
return_stmt     ::= "return" expr
while_stmt      ::= "while" expr "{" statement* "}"
for_stmt        ::= "for" Ident "in" expr expr "{" statement* "}"
match_stmt      ::= "match" expr "{" match_arm+ "}"
match_arm       ::= (String | Number | "_") "=>" ("{" statement* "}" | statement)
assign_stmt     ::= Ident "=" expr
let_stmt        ::= "let" (Ident | "(" Ident ("," Ident)* ")") "=" expr
expr_stmt       ::= expr
block           ::= "{" statement* "}"

# ---------------------------------------------------------------------------
# 6. Expressions (precedence: lowest → highest)
# ---------------------------------------------------------------------------
expr            ::= comparison

comparison      ::= additive (comp_op additive)*
comp_op         ::= "==" | "!=" | "<" | ">" | "<=" | ">="

additive        ::= multiplicative (add_op multiplicative)*
add_op          ::= "+" | "-"

multiplicative  ::= unary (mul_op unary)*
mul_op          ::= "*" | "/" | "%"

unary           ::= "-" unary | primary

primary         ::= Number | String | Bool
                  | Ident call_opt
                  | tuple
                  | list
                  | map

# Call:  name ( arg, arg )  — args separated by comma OR whitespace.
call            ::= Ident "(" expr_list ")"
call_opt        ::= "(" expr_list ")"?

# Tuple: ( x y z ) or ( r g b a ) — whitespace separated.
tuple           ::= "(" expr_list ")"

# List literal (v1.6.0): [ 1 2 3 ] or ["a", "b"] — separators optional.
list            ::= "[" expr_list "]"

# Map literal (v1.6.0): { key: expr, key2: expr } — ordered (deterministic).
map             ::= "{" (Ident ":" expr ("," Ident ":" expr)*)* "}"

# expr_list: zero or more expressions, separators are optional
# (commas are tolerated and skipped).
expr_list       ::= (expr ("," expr)*)*

Bool            ::= "true" | "false"
Ident           ::= [A-Za-z_] [A-Za-z0-9_]*

# ---------------------------------------------------------------------------
# 7. Lexical tokens
# ---------------------------------------------------------------------------
Number          ::= DecNum | HexNum | ExpNum | UnaryNum
DecNum          ::= [0-9]+ ("." [0-9]+)?
HexNum          ::= "0x" [0-9a-fA-F]+
ExpNum          ::= [0-9]+ ("." [0-9]+)? [eE] [+-]? [0-9]+
UnaryNum        ::= "-" (DecNum | HexNum)     # handled by unary rule; listed for lexer

String          ::= '"' (Char)* '"'
Char            ::= [^"\\] | "\\" ("\"" | "\\" | "n" | "t")

Comment         ::= "#" [^\n]*                # line comment
                  | "/*" (any)* "*/"          # block comment

# Operators / punctuation
#   ( ) { } , = + - * / % == != < > <= >=
# Keywords are context-sensitive Identifiers (not reserved globally):
#   world camera light entity let func on mesh material solid wire glow
#   points sphere box torus icosa ring plane grid frame speak silent click
#   intent reply task event mode payload verb content recs assign input
#   expect source key session at
#   memory fact topic confidence
#   plan steps parallel
#   state user_key speaking muted mic_active quality provider elapsed
#   if else return while for in true false
# Built-in identifiers (available in expressions):
#   t mouseX mouseY PI

# ---------------------------------------------------------------------------
# 8. Module: intent — normalized user request
#    Every incoming chat/command is translated into exactly one intent block.
# ---------------------------------------------------------------------------
intent          ::= "intent" String "{" intent_prop* "}"
intent_prop     ::= "mode" String
                  | "payload" String
                  | "verb" String
verb            ::= "ask" | "inform" | "command" | "greet" | "system"

# ---------------------------------------------------------------------------
# 9. Module: reply — structured answer
# ---------------------------------------------------------------------------
reply           ::= "reply" String "{" reply_prop* "}"
reply_prop      ::= "mode" String
                  | "content" String
                  | "recs" "[" String* "]"
                  | "world" String

# ---------------------------------------------------------------------------
# 10. Module: task — agent work order (CrewAI)
# ---------------------------------------------------------------------------
task            ::= "task" String "{" task_prop* "}"
task_prop       ::= "assign" String
                  | "input" String
                  | "expect" String

# ---------------------------------------------------------------------------
# 11. Module: event — fact / occurrence record
# ---------------------------------------------------------------------------
event           ::= "event" String "{" event_prop* "}"
event_prop      ::= "source" String
                  | "key" String
                  | "session" String
                  | "at" String
                  | "line" String        # v1.7.0 — event "syntax_error" (formal verification)
                  | "token" String
                  | "guidance" String

# ---------------------------------------------------------------------------
# 12. Module: memory — long-term fact / context exchange (v1.5.0)
# ---------------------------------------------------------------------------
memory          ::= "memory" String "{" memory_prop* "}"
memory_prop     ::= "key" String
                  | "topic" String
                  | "fact" String
                  | "confidence" String   # "0..1" (validasi 0..1)
                  | "source" String
                  | "at" String

# ---------------------------------------------------------------------------
# 13. Module: plan — DAG execution steps for CrewAI (v1.5.0)
# ---------------------------------------------------------------------------
plan            ::= "plan" String "{" plan_prop* "}"
plan_prop       ::= "steps" "[" String* "]"   # "<id>:<action>:<depends_csv>"
                  | "parallel" String          # "0" sekuensial | "1" DAG paralel

# Protocol rules (shared):
#   - Tag string is the single required positional argument (first token).
#   - Keys may appear in any order; duplicate keys are non-conforming.
#   - Unknown keys are non-conforming.
#   - Protocol modules contain only String values (and String[] for recs/steps).
#   - `world`, `intent`, `reply`, `task`, `event`, `memory`, `plan`, `state` remain
#     context-sensitive Identifiers (not globally reserved).
#   - `plan.steps` entries: "<id>:<action>:<depends_csv>" — id int unik,
#     depends = csv id langkah; must be acyclic (DAG, deterministic, P1).
#   `plan.parallel` = "1" mengizinkan leaf nodes dieksekusi bersamaan.

# ---------------------------------------------------------------------------
# 14. Module: state — frontend/backend sync (§13, v1.9.0)
# ---------------------------------------------------------------------------
state           ::= "state" String "{" state_prop* "}"
state_prop      ::= "user_key" String
                  | "session_id" String
                  | "job_id" String
                  | "muted" String       # "0" false | "1" true
                  | "speaking" String      # "0" false | "1" true
                  | "mic_active" String    # "0" false | "1" true
                  | "quality" String       # "menyambung" | "live" | "memproses" | "offline"
                  | "status" String        # status teks
                  | "progress" String      # nilai 0..100
                  | "provider" String      # nama provider LLM aktif
                  | "elapsed" String       # detik sejak call start
                  | "at" String            # ISO timestamp
# Required: user_key, at. All other fields optional.
#
# ---------------------------------------------------------------------------
# 14. Tooling & Formal Verification (v1.7.0 — NOT grammar, for documentation)
# ---------------------------------------------------------------------------
# Static analysis & self-healing vocabulary (registry kategori checker /
# compactor / selfheal — P6):
#   checker  (adilang-check):  check_src          — src/checker.rs, CLI src/bin/
#   compactor (adilang-opt):   optimize_src render_expr render_program
#                                              — src/compactor.rs, CLI src/bin/
#   selfheal (protocol):       syntax_error_event auto_fix check_adilang
#                                              — core/adilang_protocol.py
# Formal verification protocol (roadmap §4): bila LLM memproduksi ADILang yang
# syntax error, runtime membalas modul `event "syntax_error"` dengan kunci
# source/line/token/guidance (+ at) agar LLM dapat mengoreksi sendiri pada
# percobaan berikutnya (auto-correction loop). Mirror offline Python:
# scripts/adilang_check.py; WASM: adilang_check_diagnostics, adilang_optimize.
#
# ---------------------------------------------------------------------------
# 12. Binary transport note (v1.4.0 — NOT grammar, for documentation)
# ---------------------------------------------------------------------------
# ADILang text (grammar above) is compiled by the Rust world runtime into a
# bit-packed BINARY format for real-time multiplayer transport (WebSocket
# antar-client). It is NOT part of the grammar — it is an encoding of scene
# state. Spec: LANGUAGE.md §12.2; implementation: src/bytecode.rs.
#   - Header 4B: magic 0xAD | version 0x01 | flags (bit0=DELTA) | count(u8).
#   - FULL snapshot: 21B/entity (mesh3b|mat2b bit-packed, id u8, pos i16x3,
#     rot i16x3, scale u8x3, color u8x4) — kuantisasi deterministik.
#   - DELTA: mask-based (bit0 pos, bit1 rot, bit2 scale, bit3 color,
#     bit4 mesh/material) — hanya field yang berubah; struktur berubah = FULL.
#   - Registry kategori `binary` meng-enumerasi API bytecode (P6).
#
# ---------------------------------------------------------------------------
# 20. Dense opcode map note (v1.14.0 — NOT grammar, for documentation)
# ---------------------------------------------------------------------------
# Dense Compact AST (src/dense.rs) is a bitstream ENCODING of the program for
# machine-to-machine transfer; it is NOT an alternative grammar (the text
# grammar above remains canonical). Opcode map (registry kategori `dense`):
#   0x01 NodeContainer   0x0A WebGLMeshCube   0x11 Node3DCamera
#   0x02 NodeText        0x0B WebGLMeshSphere 0x12 Node3DLight
#   0x03 NodeButton      0x0C WebGLMeshTorus  0x13 Node3DEntity
#   0x04 NodeInput       0x0D WebGLMeshIcosa
#   0x05 NodeImage       0x0E WebGLMeshRing
#   0x06 NodeNavbar      0x0F WebGLMeshPlane
#   0x07 NodeCard        0x10 WebGLMeshGrid
#   0x08 NodeModal
#   0x09 NodeFooter / DENSE_LAYOUT_FLEX
# encode_program/decode_program round-trip identik AST; machine_runner
# (src/machine_runner.rs) menginterpretasi bitstream langsung ke DOM/WebGL2 ops
# tanpa string parse. AI Guard (src/ai_guard.rs) menandai output mesin dengan
# `# ADILANG-SIG: <fnv1a64-hex>` + entropi Shannon (threshold 6.0) + handshake
# `ADI-HANDSHAKE:`. Diagnostics (src/diagnostics.rs) mengemas error mesin sebagai
# payload {err: 0x0E1..0x0EB, node} / vector `0E4:12`.
